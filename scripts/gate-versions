#!/usr/bin/env bash
# The target-version part of the merge gate (ADR 0009; decision 13 of
# docs/plans/2026-09-22-target-versions.md).
#
# Usage: scripts/gate-versions [FEATURE...]
#
# FEATURE is a version feature: pg14, pg15, pg16, pg17, pg18 or pg19-beta.
# With no argument, the script runs all six, one after the other. For each
# version it builds pg-sql with `FEATURE,spans` (the configuration that
# consumers use) and runs the core test targets, the differential against
# that version's oracle, pg-psql and pg-oracle. For pg17 it also runs the
# no-spans and `arbitrary` combinations.
#
# Each version is a different build of the generated grammar, and the first
# build of each oracle of each version builds PostgreSQL: pg-oracle under its
# OUT_DIR, pg-psql-oracle under target/pg-trees. A full run is slow and needs
# several GB of disk for each version.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
# A RUSTUP_TOOLCHAIN from the shell overrides rust-toolchain.toml.
unset RUSTUP_TOOLCHAIN
# Each version is its own build, so the incremental cache of one version is
# never read again, and a full run leaves about 110 GB of it behind. The gate
# does not need it: set CARGO_INCREMENTAL=1 to get it back.
export CARGO_INCREMENTAL="${CARGO_INCREMENTAL:-0}"

versions=("$@")
if [ "${#versions[@]}" -eq 0 ]; then
  versions=(pg14 pg15 pg16 pg17 pg18 pg19-beta)
fi

run() {
  echo "+ $*" >&2
  "$@"
}

# The pg-sql test targets that the gate runs at each version (#95). A new
# target goes in one of the two lists, or in `excluded_tests` with a reason;
# the check below fails before any build when a target is in none of them.
core_tests=(
  embedded embedded_inventory differential_baseline target_version
  strict_statement fmt flat_parity minimum_version minimum_version_corpus
  declared_precedence declared_rejections document ident lex_identity
  table_parser
)
oracle_tests=(differential accepted_legacy_gaps)
# Format: "name: reason". The gate runs every pg-sql test target now, so the
# list is empty.
excluded_tests=()

command -v jq >/dev/null || { echo "jq is required" >&2; exit 2; }
listed_tests="$(
  printf '%s\n' "${core_tests[@]}" "${oracle_tests[@]}"
  for entry in ${excluded_tests[@]+"${excluded_tests[@]}"}; do
    printf '%s\n' "${entry%%:*}"
  done
)"
package_tests="$(
  cargo metadata --locked --no-deps --format-version 1 |
    jq -r --arg manifest "$PWD/Cargo.toml" '
      .packages[] | select(.manifest_path == $manifest)
      | .targets[] | select(.kind | index("test")) | .name'
)"
unlisted="$(comm -23 <(sort -u <<<"$package_tests") <(sort -u <<<"$listed_tests"))"
if [ -n "$unlisted" ]; then
  echo "pg-sql test targets that the gate neither runs nor excludes:" >&2
  echo "$unlisted" >&2
  exit 1
fi
unknown="$(comm -13 <(sort -u <<<"$package_tests") <(sort -u <<<"$listed_tests"))"
if [ -n "$unknown" ]; then
  echo "gate lists that name no pg-sql test target:" >&2
  echo "$unknown" >&2
  exit 1
fi

core_args=()
for name in "${core_tests[@]}"; do core_args+=(--test "$name"); done
oracle_args=()
for name in "${oracle_tests[@]}"; do oracle_args+=(--test "$name"); done

for version in "${versions[@]}"; do
  case "$version" in
    pg14|pg15|pg16|pg17|pg18|pg19-beta) ;;
    *) echo "unknown version feature: $version" >&2; exit 2 ;;
  esac
  echo "=== target version $version" >&2
  spans=(--no-default-features --features "$version,spans")
  oracle=(--no-default-features --features "$version,spans,postgres-oracle")

  run cargo build --locked -p pg-sql "${spans[@]}"
  run cargo test --locked -p pg-sql "${spans[@]}" "${core_args[@]}"
  run cargo test --locked -p pg-sql "${oracle[@]}" "${oracle_args[@]}"
  run cargo test --locked -p pg-psql --no-default-features --features "$version"
  run cargo test --locked -p pg-oracle --no-default-features --features "$version"
  # The psql oracle (#79): psql's own lexer of the same pinned release.
  run cargo test --locked -p pg-psql-oracle --no-default-features --features "$version"
  run cargo test --locked -p pg-psql --no-default-features \
    --features "$version,psql-oracle"

  if [ "$version" = pg17 ]; then
    # The no-spans and arbitrary combinations run on pg17 only.
    run cargo test --locked -p pg-sql \
      --test embedded --test embedded_inventory --test differential_baseline \
      --test flat_parity
    run cargo test --locked -p pg-sql --features postgres-oracle \
      --test differential --test accepted_legacy_gaps
    run cargo build --locked -p pg-sql --features arbitrary
  fi
done

echo "target-version gate passed: ${versions[*]}" >&2
