#!/usr/bin/env bash
# The Grammar Version part of the merge gate (ADR 0005).
#
# Usage: scripts/gate-versions [FEATURE...]
#
# FEATURE is a version feature: pg14, pg15, pg16, pg17, pg18 or pg19-beta.
# With no argument, the script runs all six, one after the other. For each
# version it runs clippy and the full test suite in that build. The Oracle
# harness runs only in the pg17 build, and only when PG_ANALYZE_ORACLE_URL
# is set.
#
# Each version has its own target directory under target/versions, because
# each one is a different build of the pg-sql grammar and a shared directory
# would rebuild it at every switch.
set -euo pipefail

cd "$(git rev-parse --show-toplevel)"
# A RUSTUP_TOOLCHAIN from the shell overrides rust-toolchain.toml.
unset RUSTUP_TOOLCHAIN

versions=("$@")
if [ "${#versions[@]}" -eq 0 ]; then
  versions=(pg14 pg15 pg16 pg17 pg18 pg19-beta)
fi

run() {
  echo "+ $*" >&2
  "$@"
}

for version in "${versions[@]}"; do
  case "$version" in
    pg14|pg15|pg16|pg17|pg18|pg19-beta) ;;
    *) echo "unknown version feature: $version" >&2; exit 2 ;;
  esac
  echo "=== grammar version $version" >&2
  export CARGO_TARGET_DIR="target/versions/$version"
  features=(--no-default-features --features "$version")

  run cargo clippy --locked --all-targets "${features[@]}" -- -D warnings
  run cargo test --locked "${features[@]}"
done
