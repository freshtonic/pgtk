#!/usr/bin/env bash
# Check that each commit in a range has a Conventional Commits subject
# (https://www.conventionalcommits.org/en/v1.0.0/). release-plz makes the
# changelogs from these subjects (release-plz.toml).
#
# A subject is `<type>[(<scope>)][!]: <description>`, for example
# `fix(pgtk-sql): reject a second WITH in CREATE DATABASE`. Merge commits are
# not checked.
#
# Usage: scripts/check-conventional-commits <base> [<head>]
#   CI gives the base branch of the pull request: origin/main.

set -euo pipefail

base=${1:?usage: scripts/check-conventional-commits <base> [<head>]}
head=${2:-HEAD}

types='feat|fix|docs|style|refactor|perf|test|build|ci|chore|revert'
pattern="^(${types})(\([a-z0-9][a-z0-9._/-]*\))?!?: [^ ].*"

bad=0
while IFS=$'\t' read -r sha subject; do
  if [[ ! $subject =~ $pattern ]]; then
    printf 'error: %s is not a conventional commit: %s\n' "${sha:0:8}" "$subject" >&2
    bad=1
  fi
done < <(git log --no-merges --format='%H%x09%s' "$base..$head")

if [[ $bad == 1 ]]; then
  cat >&2 <<MSG

Each commit subject must be <type>[(<scope>)][!]: <description>, where <type> is one of:
  ${types//|/, }
Change the subjects with: git rebase -i $base (reword), then push again. See CONTRIBUTING.md.
MSG
  exit 1
fi
echo "every commit in $base..$head is a conventional commit"
