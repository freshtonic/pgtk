[package]
name = "recursa-codegen"
version = "0.1.0"
description = "Build-time grammar analysis and code generation for Recursa"
authors.workspace = true
edition.workspace = true
rust-version.workspace = true
license.workspace = true
repository.workspace = true
documentation = "https://docs.rs/recursa-codegen"
keywords = ["parser", "parser-generator", "grammar", "code-generation"]
categories = ["parsing", "development-tools::build-utils"]
include = [
    "build.rs",
    "src/**",
    "!src/semantic_projection_tests.rs",
    "!src/source_analysis_contract_tests.rs",
    "!src/source_analysis_tests.rs",
    "README.md",
    "LICENSE",
]

[features]
default = []
diagrams = ["dep:recursa-diagrams"]
explorer = []
spans = []

[dependencies]
phf_codegen = "0.11.3"
proc-macro2 = { version = "1", features = ["span-locations"] }
prettyplease = "0.2"
quote = "1"
regex-automata = "0.4"
regex-syntax = "0.8"
recursa-diagrams = { version = "=0.1.0", path = "../recursa-diagrams", optional = true }
syn = { version = "2", features = ["extra-traits", "full", "parsing", "visit", "visit-mut"] }
unicode-ident = "1"

[dev-dependencies]
roxmltree = "0.21"
tempfile = "3"

[[test]]
name = "generated_one_node"
path = "tests/generated_one_node.rs"
