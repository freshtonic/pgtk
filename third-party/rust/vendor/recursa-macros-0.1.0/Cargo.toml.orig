[package]
name = "recursa-macros"
version = "0.1.0"
description = "Structural proc-macro loaders for Recursa-generated parsers"
authors.workspace = true
edition.workspace = true
rust-version.workspace = true
license.workspace = true
repository.workspace = true
documentation = "https://docs.rs/recursa-macros"
keywords = ["parser", "parser-generator", "procedural-macro", "grammar"]
categories = ["parsing", "development-tools::procedural-macro-helpers"]
include = ["src/**", "README.md", "LICENSE"]

[features]
default = []
arbitrary = []
diagrams = ["dep:recursa-diagrams"]
explorer = []
serde = []

[lib]
proc-macro = true

[dependencies]
proc-macro-crate = "3"
recursa-diagrams = { version = "=0.1.0", path = "../recursa-diagrams", optional = true }
proc-macro2 = { version = "1", features = ["span-locations"] }
quote = "1"
syn = { version = "2", features = ["full", "visit-mut"] }
