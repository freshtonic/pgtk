[package]
name = "recursa"
version = "0.1.0"
description = "AST-first parser generator for Rust"
authors.workspace = true
edition.workspace = true
rust-version.workspace = true
license.workspace = true
repository.workspace = true
documentation = "https://docs.rs/recursa"
keywords = ["parser", "parser-generator", "ast", "grammar"]
categories = ["parsing"]
include = ["src/**", "README.md", "LICENSE"]

[features]
default = []
arbitrary = ["recursa-core/arbitrary", "recursa-macros/arbitrary"]
diagrams = ["recursa-core/diagrams", "recursa-macros/diagrams"]
explorer = ["recursa-core/explorer", "recursa-macros/explorer"]
serde = ["recursa-core/serde", "recursa-macros/serde"]
spans = ["recursa-core/spans"]

[dependencies]
recursa-core = { version = "=0.1.0", path = "../recursa-core" }
recursa-macros = { version = "=0.1.0", path = "../recursa-macros" }
