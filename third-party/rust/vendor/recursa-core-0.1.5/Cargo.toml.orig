[package]
name = "recursa-core"
version = "0.1.5"
description = "Runtime support for Recursa-generated parsers"
authors.workspace = true
edition.workspace = true
rust-version.workspace = true
license.workspace = true
repository.workspace = true
documentation = "https://docs.rs/recursa-core"
keywords = ["parser", "parser-generator", "ast", "grammar"]
categories = ["parsing"]
include = ["src/**", "README.md", "LICENSE"]

[features]
default = []
arbitrary = ["dep:arbitrary"]
diagrams = ["dep:recursa-diagrams"]
explorer = ["statistics"]
serde = ["dep:serde"]
spans = []
statistics = []

[dependencies]
arbitrary = { version = "1", optional = true }
bumpalo = { version = "3.20", features = ["boxed", "collections"] }
logos = { version = "0.16", default-features = false, features = ["std", "export_derive"] }
phf = "0.11.3"
recursa-diagrams = { version = "=0.1.5", path = "../recursa-diagrams", optional = true }
serde = { version = "1", features = ["derive"], optional = true }
self_cell = "1.2"
