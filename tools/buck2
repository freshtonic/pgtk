#!/usr/bin/env bash
# Runs the pinned buck2 (tools/buck2.dotslash) with the pgtk build settings.
#
# Before each command, the script writes .buckconfig.pgtk, which .buckconfig includes and git
# ignores:
#
# - [pgtk] toolchain_id: a hash of the system toolchain that the build uses (rustc, clang and the
#   SDK or C library). The execution platform (platforms/defs.bzl) puts it into the key of every
#   action, so the remote cache never gives an output of one toolchain to another toolchain.
# - When BUILDBUDDY_API_KEY is set: the BuildBuddy remote cache. Buck2 reads the key from the
#   environment, so the key is never written to a file. Without the key, the build uses no remote
#   cache.
#
# The script writes the file only when its contents change, because a change of the configuration
# restarts the buck2 daemon.
set -euo pipefail

root="$(cd "$(dirname "${BASH_SOURCE[0]}")/.." && pwd)"

toolchain_id() {
  # rustc runs in the repository root, so rustup selects the toolchain of rust-toolchain.toml, as
  # it does for the build.
  (cd "$root" && rustc -vV)
  /usr/bin/clang --version
  /usr/bin/clang++ --version
  uname -sm
  case "$(uname -s)" in
    Darwin) xcrun --show-sdk-version && xcrun --show-sdk-build-version ;;
    Linux) ldd --version | head -1 ;;
  esac
}

id="$(toolchain_id | shasum -a 256 | cut -c1-16)"
# buck2 takes the address without the `grpcs` scheme; `tls = true` turns on TLS.
endpoint="${BUILDBUDDY_ENDPOINT:-grpc://remote.buildbuddy.io:443}"

config="# Written by tools/buck2. Do not edit.
[pgtk]
  toolchain_id = $id"
if [ -n "${BUILDBUDDY_API_KEY:-}" ]; then
  config+="
  remote_cache = true

[buck2_re_client]
  engine_address = $endpoint
  action_cache_address = $endpoint
  cas_address = $endpoint
  tls = true
  http_headers = x-buildbuddy-api-key:\$BUILDBUDDY_API_KEY"
else
  config+="
  remote_cache = false"
fi

file="$root/.buckconfig.pgtk"
if [ "$(cat "$file" 2>/dev/null || true)" != "$config" ]; then
  printf '%s\n' "$config" > "$file"
fi

exec "$root/tools/buck2.dotslash" "$@"
